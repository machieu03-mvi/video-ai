  {
   "i": 20,
   "start": 72.0,
   "end": 75.824,
   "startFrame": 2160,
   "endFrame": 2275,
   "words": 13,
   "text": "bạn có thể tiếp tục thêm quy tắc thứ hai, rồi thứ ba."
  },
  {
   "i": 21,
   "start": 76.074,
   "end": 80.191,
   "startFrame": 2282,
   "endFrame": 2406,
   "words": 14,
   "text": "Kỷ luật được xây dựng từng bước, qua những việc nhỏ được lặp lại."
  },
  {
   "i": 22,
   "start": 81.041,
   "end": 83.394,
   "startFrame": 2431,
   "endFrame": 2502,
   "words": 8,
   "text": "Nhưng có quy tắc thôi vẫn chưa đủ."
  },
  {
   "i": 23,
   "start": 83.644,
   "end": 84.844,
   "startFrame": 2509,
   "endFrame": 2545,
   "words": 4,
   "text": "Trước khi vào lệnh,"
