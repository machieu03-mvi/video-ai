  {
   "i": 17,
   "start": 62.709,
   "end": 65.356,
   "startFrame": 1881,
   "endFrame": 1961,
   "words": 9,
   "text": "Sau mỗi lần như vậy, hãy ghi nhận rằng:"
  },
  {
   "i": 18,
   "start": 65.606,
   "end": 68.547,
   "startFrame": 1968,
   "endFrame": 2056,
   "words": 10,
