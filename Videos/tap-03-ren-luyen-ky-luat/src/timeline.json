   "i": 40,
   "start": 141.271,
   "end": 145.094,
   "startFrame": 4238,
   "endFrame": 4353,
   "words": 13,
   "text": "Trước khi bấm chuột, hãy đọc từng câu hỏi và tự trả lời."
