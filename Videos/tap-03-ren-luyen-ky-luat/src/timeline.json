  {
   "i": 4,
   "start": 14.376,
   "end": 18.494,
   "startFrame": 431,
   "endFrame": 555,
   "words": 14,
   "text": "Phải chờ đúng tín hiệu, phải tính toán rủi ro, phải ghi nhật ký,"
