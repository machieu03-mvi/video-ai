  {
   "i": 12,
   "start": 44.671,
   "end": 47.024,
   "startFrame": 1340,
   "endFrame": 1411,
   "words": 8,
   "text": "Bạn có thể phân tích sai xu hướng."
  },
  {
   "i": 13,
   "start": 47.274,
   "end": 49.332,
   "startFrame": 1418,
   "endFrame": 1480,
   "words": 7,
   "text": "Bạn có thể chọn sai điểm vào."
  },
  {
   "i": 14,
   "start": 49.582,
   "end": 54.876,
   "startFrame": 1487,
   "endFrame": 1646,
   "words": 18,
   "text": "Thậm chí, giá có thể chạm điểm dừng lỗ rồi quay đầu đi đúng hướng bạn dự đoán."
