  {
   "i": 24,
   "start": 85.094,
   "end": 89.506,
   "startFrame": 2553,
   "endFrame": 2685,
   "words": 15,
   "text": "bạn cần một cách để kiểm tra xem mình có đang làm đúng hay không."
