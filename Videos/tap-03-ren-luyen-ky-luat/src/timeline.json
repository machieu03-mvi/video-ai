 "cues": [
  {
   "i": 0,
   "start": 1.0,
   "end": 5.412,
   "startFrame": 30,
   "endFrame": 162,
   "words": 15,
   "text": "Ở tập trước, chúng ta đã nói rằng kỷ luật giống như một cơ bắp:"
  },
  {
   "i": 1,
   "start": 5.662,
   "end": 7.721,
   "startFrame": 170,
   "endFrame": 232,
   "words": 7,
   "text": "muốn mạnh lên thì phải luyện tập."
  },
  {
   "i": 2,
   "start": 8.571,
   "end": 10.335,
   "startFrame": 257,
   "endFrame": 310,
   "words": 6,
   "text": "Nhưng nên bắt đầu từ đâu?"
  },
  {
   "i": 3,
   "start": 11.185,
   "end": 14.126,
   "startFrame": 336,
   "endFrame": 424,
   "words": 10,
