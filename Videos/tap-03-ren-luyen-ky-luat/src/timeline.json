   "end": 177.741,
   "startFrame": 5244,
   "endFrame": 5332,
   "words": 10,
   "text": "Trong khoảnh khắc đó, hãy thử dừng lại ba giây."
  },
  {
   "i": 49,
   "start": 178.591,
