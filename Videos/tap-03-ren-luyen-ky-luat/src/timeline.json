   "i": 15,
   "start": 55.726,
   "end": 58.962,
   "startFrame": 1672,
   "endFrame": 1769,
   "words": 11,
   "text": "Nhưng nếu bạn đã đặt điểm dừng lỗ theo kế hoạch,"
